getwd()
station_hour <- read.csv("station_hour_cleaned", header = FALSE)
stations <- read.csv("stations.csv")
station_hour <- read.csv("station_hour_cleaned.csv", header = FALSE)
# Assign column names manually for station_hour
colnames(station_hour) <- c(
"StationId", "Datetime", "PM2.5", "PM10", "NO", "NO2", "NOx", "NH3",
"CO", "SO2", "O3", "Benzene", "Toluene", "Xylene", "AQI", "AQI_Category", "Hour"
)
# Convert Datetime to POSIXct
station_hour$Datetime <- ymd_hms(station_hour$Datetime)
# Merge to add City and State info
data <- merge(station_hour, stations, by.x = "StationId", by.y = "StationId", all.x = TRUE)
# Keep only useful columns
data <- data %>%
select(Datetime, City, State, PM2.5, PM10, NO, NO2, NOx, NH3, CO, SO2, O3)
# Remove NAs
data <- na.omit(data)
ggplot(data, aes(x = Datetime, y = PM2.5, color = City)) +
geom_line() +
labs(title = "PM2.5 Concentration Over Time", y = "PM2.5 (µg/m³)") +
theme_minimal()
ggplot(data, aes(x = reorder(City, PM2.5, median), y = PM2.5, fill = City)) +
geom_boxplot() +
coord_flip() +
labs(title = "City-wise Distribution of PM2.5") +
theme_minimal()
ggplot(data, aes(x = reorder(City, PM2.5, median), y = PM2.5, fill = City)) +
geom_boxplot() +
coord_flip() +
labs(title = "City-wise Distribution of PM2.5") +
theme_minimal()
library(dplyr)
library(lubridate)
library(ggplot2)
# Sample small portion for testing visuals (1% or 50k rows)
sampled_data <- data %>% sample_n(min(50000, nrow(data)))
# Aggregate hourly data into daily averages per city
daily_data <- data %>%
mutate(Date = as.Date(Datetime)) %>%
group_by(City, State, Date) %>%
summarise(across(c(PM2.5, PM10, NO2, SO2, O3), mean, na.rm = TRUE)) %>%
ungroup()
daily_data %>%
group_by(City) %>%
summarise(avg_PM2.5 = mean(PM2.5, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(City, avg_PM2.5), y = avg_PM2.5, fill = City)) +
geom_col(show.legend = FALSE) +
coord_flip() +
labs(title = "Average PM2.5 per City", y = "PM2.5 (µg/m³)", x = "") +
theme_minimal()
daily_data %>%
group_by(City) %>%
summarise(avg_PM2.5 = mean(PM2.5, na.rm = TRUE)) %>%
ggplot(aes(x = reorder(City, avg_PM2.5), y = avg_PM2.5, fill = City)) +
geom_col(show.legend = FALSE) +
coord_flip() +
labs(title = "Average PM2.5 per City", y = "PM2.5 (µg/m³)", x = "") +
theme_minimal()
View(stations)
View(daily_data)
View(data)
View(station_hour)
# Load required packages
library(dplyr)
library(lubridate)
# Example: load your dataset
# Replace this with your actual file path
data <- read.csv("station_hour_cleaned.csv")
# Quick check
head(data)
str(data)
# Convert Datetime to Date
data$Datetime <- ymd_hms(data$Datetime)
data$Date <- as.Date(data$Datetime)
# Remove rows with missing values (for simplicity)
data <- na.omit(data)
# Build a linear regression model
model <- lm(PM2.5 ~ PM10 + NO2 + SO2 + O3, data = data)
# View summary of the model
summary(model)
# Predict PM2.5 values using the trained model
predictions <- predict(model, newdata = data)
# Add predictions to the dataset
data$Predicted_PM2.5 <- predictions
# View first few results
head(data[, c("PM2.5", "Predicted_PM2.5")])
# Calculate Mean Squared Error (MSE)
mse <- mean((data$PM2.5 - data$Predicted_PM2.5)^2)
print(paste("MSE:", mse))
# Calculate R-squared manually for verification
r2 <- 1 - sum((data$PM2.5 - data$Predicted_PM2.5)^2) / sum((data$PM2.5 - mean(data$PM2.5))^2)
print(paste("R-squared:", r2))
library(ggplot2)
ggplot(data, aes(x = PM2.5, y = Predicted_PM2.5)) +
geom_point(alpha = 0.3, color = "blue") +
geom_abline(slope = 1, intercept = 0, color = "red", linetype = "dashed") +
labs(title = "Actual vs Predicted PM2.5",
x = "Actual PM2.5",
y = "Predicted PM2.5") +
theme_minimal()
# Pick one city for clarity
city_example <- data_sample %>% filter(City == unique(City)[1]) %>% head(500)
View(sampled_data)
View(sampled_data)
View(sampled_data)
