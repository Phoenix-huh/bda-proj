data <- read.csv("station_hour_cleaned.csv", stringsAsFactors = FALSE)

# Convert Datetime to POSIXct
data$Datetime <- ymd_hms(data$Datetime)

# Remove missing values
data <- na.omit(data)

# Create a sample for faster plotting (50k rows max)
set.seed(123)
sampled_data <- data %>% sample_n(min(50000, nrow(data)))

# Quick check
head(sampled_data)

model <- lm(PM2.5 ~ PM10 + NO2 + SO2 + O3, data = sampled_data)

# Make predictions on the same sampled data
sampled_data$Predicted_PM2.5 <- predict(model, newdata = sampled_data)

# Check first few predictions
head(sampled_data[, c("PM2.5", "Predicted_PM2.5")])


ggplot(sampled_data, aes(x = PM2.5, y = Predicted_PM2.5)) +
  geom_point(alpha = 0.4, color = "steelblue") +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "red") +
  labs(title = "Actual vs Predicted PM2.5",
       x = "Actual PM2.5",
       y = "Predicted PM2.5") +
  theme_minimal()

